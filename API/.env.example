# 复制本文件为 API/.env 后填写。不要提交真实密钥。

# Comfly/OpenAI 兼容平台
COMFLY_BASE_URL=https://ai.comfly.org
COMFLY_API_KEY=

# 其他 OpenAI 兼容平台的 Key 通常由“API 设置”页面写入对应变量。
API_PROVIDER_API_6789_KEY=

# 可选：启动时提供默认模型列表。推荐在界面中实时拉取模型。
IMAGE_MODELS=
CHAT_MODELS=
VIDEO_MODELS=
MODELSCOPE_CHAT_MODELS=

# 可选服务与超时
# MODELSCOPE_API_KEY=
# COMFYUI_INSTANCES=127.0.0.1:8188
# PUBLIC_BASE_URL=
# PUBLIC_MEDIA_BASE_URL=
# REQUEST_TIMEOUT=1800
# Antigravity CLI 图片任务固定等待 300 秒，不读取环境变量覆盖；GEMINI_CLI_TIMEOUT 只影响聊天任务。
# GEMINI_CLI_TIMEOUT=900
# GPT 对话 Agent：普通问答/图片分析默认跳过意图路由；需要判断生图工具时使用以下短超时。
# CHAT_AGENT_ROUTER_TIMEOUT=30
# CHAT_AGENT_REPLY_TIMEOUT=90
# CHAT_STREAM_TIMEOUT=90
# GPT CLI 对话使用较低推理强度和独立超时，减少普通问答的首字节等待。
# CODEX_CHAT_REASONING_EFFORT=low
# CODEX_CHAT_TIMEOUT=180
# GPT CLI 对话默认强制走 HTTPS，避免 WebSocket 失败时反复重连；需要自定义网关时覆盖地址。
# CODEX_CHAT_FORCE_HTTPS=1
# CODEX_CHAT_BASE_URL=https://chatgpt.com/backend-api/codex
  # 商品分析右侧小美面板的流式聊天默认允许 300 秒，评价/详情快照较大时避免过早停止
# COMMERCE_CHAT_STREAM_TIMEOUT=300
# CHAT_AGENT_RETRIES=1
# CHAT_AGENT_RETRY_DELAY=1.2
# 小美画布 Agent 的视觉策划/提示词请求总预算默认 90 秒；慢速推理模型可按需调大。
# CANVAS_LLM_TIMEOUT=90
# 同一平台有备用聊天模型时，每个模型默认最多等待 45 秒再切换。
# CANVAS_LLM_ATTEMPT_TIMEOUT=45
# 上游模型临时不可用时，最多自动尝试 2 个同平台已拉取的备用聊天模型。
# CANVAS_LLM_FALLBACK_MODELS=2
# CANVAS_LLM_RETRIES=2
# CANVAS_LLM_RETRY_DELAY=1.2
# IMAGE_TASK_TIMEOUT=1800
# GPT-Image-2 画布批量编辑并发数，默认 2；兼容网关不稳定时改为 1
# GPT_IMAGE2_EDIT_CONCURRENCY=2
# VIDEO_POLL_TIMEOUT=1800
