{
  "manifest_version": 3,
  "name": "小美画布网页素材采集",
  "description": "扫描、截图和下载当前网页素材，也可导入本机小美画布。",
  "version": "2.0.0",
  "action": {
    "default_title": "采集网页素材",
    "default_popup": "popup.html",
    "default_icon": "brand.png"
  },
  "icons": {
    "128": "brand.png"
  },
  "side_panel": {
    "default_path": "popup.html?side=1"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "webRequest",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
